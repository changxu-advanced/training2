  "constraints": [
    {
      "table_name": "order_items",
      "name": "order_items_code_format",
      "type": "c",
      "definition": "CHECK ((product_code ~ '^[A-Z0-9_-]{1,32}$'::text))"
    },
    {
      "table_name": "order_items",
      "name": "order_items_name_length",
      "type": "c",
      "definition": "CHECK ((((char_length(product_name) >= 1) AND (char_length(product_name) <= 100)) AND (product_name = btrim(product_name))))"
    },
    {
      "table_name": "order_items",
      "name": "order_items_order_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE"
    },
    {
      "table_name": "order_items",
      "name": "order_items_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (order_id, product_id)"
    },
    {
      "table_name": "order_items",
      "name": "order_items_price_range",
      "type": "c",
      "definition": "CHECK (((unit_price_jpy >= 0) AND (unit_price_jpy <= 100000000)))"
    },
    {
      "table_name": "order_items",
      "name": "order_items_product_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "order_items",
      "name": "order_items_quantity_range",
      "type": "c",
      "definition": "CHECK (((quantity >= 1) AND (quantity <= 1000)))"
    },
    {
      "table_name": "orders",
      "name": "orders_deleted_cancelled",
      "type": "c",
      "definition": "CHECK (((deleted_at IS NULL) OR (status = 'cancelled'::order_status)))"
    },
    {
      "table_name": "orders",
      "name": "orders_owner_key_unique",
      "type": "u",
      "definition": "UNIQUE (owner_sub, idempotency_key)"
    },
    {
      "table_name": "orders",
      "name": "orders_owner_length",
      "type": "c",
      "definition": "CHECK ((((char_length(owner_sub) >= 1) AND (char_length(owner_sub) <= 255)) AND (owner_sub = btrim(owner_sub))))"
    },
    {
      "table_name": "orders",
      "name": "orders_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "orders",
      "name": "orders_request_items_shape",
      "type": "c",
      "definition": "CHECK (\nCASE\n    WHEN (jsonb_typeof(request_items) = 'array'::text) THEN ((jsonb_array_length(request_items) >= 1) AND (jsonb_array_length(request_items) <= 50))\n    ELSE false\nEND)"
    },
    {
      "table_name": "orders",
      "name": "orders_status_timestamps",
      "type": "c",
      "definition": "CHECK ((((status = 'draft'::order_status) AND (confirmed_at IS NULL) AND (cancelled_at IS NULL)) OR ((status = 'confirmed'::order_status) AND (confirmed_at IS NOT NULL) AND (cancelled_at IS NULL)) OR ((status = 'cancelled'::order_status) AND (cancelled_at IS NOT NULL))))"
    },
    {
      "table_name": "orders",
      "name": "orders_timestamp_order",
      "type": "c",
      "definition": "CHECK ((((confirmed_at IS NULL) OR (confirmed_at >= created_at)) AND ((cancelled_at IS NULL) OR (cancelled_at >= created_at)) AND ((confirmed_at IS NULL) OR (cancelled_at IS NULL) OR (cancelled_at >= confirmed_at))))"
    },
    {
      "table_name": "orders",
      "name": "orders_total_range",
      "type": "c",
      "definition": "CHECK (((total_jpy >= 0) AND (total_jpy <= '5000000000000'::bigint)))"
    },
    {
      "table_name": "product_restocks",
      "name": "product_restocks_owner_sub_check",
      "type": "c",
      "definition": "CHECK (((char_length(owner_sub) >= 1) AND (char_length(owner_sub) <= 255)))"
    },
    {
      "table_name": "product_restocks",
      "name": "product_restocks_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (owner_sub, idempotency_key)"
    },
    {
      "table_name": "product_restocks",
      "name": "product_restocks_product_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "product_restocks",
      "name": "product_restocks_quantity_check",
      "type": "c",
      "definition": "CHECK (((quantity >= 1) AND (quantity <= 2000)))"
    },
    {
      "table_name": "products",
      "name": "products_code_format",
      "type": "c",
      "definition": "CHECK ((code ~ '^[A-Z0-9_-]{1,32}$'::text))"
    },
    {
      "table_name": "products",
      "name": "products_code_key",
      "type": "u",
      "definition": "UNIQUE (code)"
    },
    {
      "table_name": "products",
      "name": "products_description_length",
      "type": "c",
      "definition": "CHECK ((char_length(description) <= 2000))"
    },
    {
      "table_name": "products",
      "name": "products_name_length",
      "type": "c",
      "definition": "CHECK ((((char_length(name) >= 1) AND (char_length(name) <= 100)) AND (name = btrim(name))))"
    },
    {
      "table_name": "products",
      "name": "products_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "products",
      "name": "products_price_range",
      "type": "c",
      "definition": "CHECK (((price_jpy >= 0) AND (price_jpy <= 100000000)))"
    },
    {
      "table_name": "products",
      "name": "products_stock_range",
      "type": "c",
      "definition": "CHECK (((stock >= 0) AND (stock <= 1000000)))"
    },
    {
      "table_name": "schema_migrations",
      "name": "schema_migrations_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (name)"
    }
  ],
