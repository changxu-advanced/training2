  "functions": [
    {
      "name": "notify_catalog_change",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.notify_catalog_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  PERFORM pg_notify('training2_catalog', 'changed');\n  RETURN NULL;\nEND;\n$function$\n"
    },
    {
      "name": "set_updated_at",
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  NEW.updated_at = clock_timestamp();\n  RETURN NEW;\nEND;\n$function$\n"
    }
  ],
  "triggers": [
    {
      "table_name": "orders",
      "name": "orders_updated_at",
      "definition": "CREATE TRIGGER orders_updated_at BEFORE UPDATE ON public.orders FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
    },
    {
      "table_name": "products",
      "name": "catalog_changed",
      "definition": "CREATE TRIGGER catalog_changed AFTER INSERT OR DELETE OR UPDATE ON public.products FOR EACH STATEMENT EXECUTE FUNCTION notify_catalog_change()"
    },
    {
      "table_name": "products",
      "name": "products_updated_at",
      "definition": "CREATE TRIGGER products_updated_at BEFORE UPDATE ON public.products FOR EACH ROW EXECUTE FUNCTION set_updated_at()"
    }
  ]
}
