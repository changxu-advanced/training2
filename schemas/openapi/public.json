    "/orders/{id}/confirm": {
      "post": {
        "operationId": "confirmOrder",
        "summary": "Confirm once with atomic stock allocation",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
