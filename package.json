{
  "name": "training2",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "seed:cognito": "node tools/scripts/check-local-auth.mjs",
    "dev:public-api": "pnpm --filter @training2/public-api dev",
    "dev:private-api": "pnpm --filter @training2/private-api dev",
    "check:environment": "bash tools/scripts/check-environment.sh",
    "dev:public-frontend": "pnpm --filter @training2/public-frontend dev",
    "dev:private-frontend": "pnpm --filter @training2/private-frontend dev",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky",
    "db:migrate": "pnpm --filter @training2/postgres migrate",
    "db:seed": "pnpm --filter @training2/postgres seed",
    "db:schema": "pnpm --filter @training2/postgres schema:generate",
    "db:schema:check": "pnpm --filter @training2/postgres schema:check",
    "prisma:generate": "pnpm --filter @training2/prisma generate",
    "prisma:check": "pnpm --filter @training2/prisma generate:check",
    "codegen": "node tools/codegen/api.ts",
    "codegen:check": "node tools/codegen/api.ts --check",
    "screen:generate": "node packages/screen-contracts/scripts/check.ts --write",
    "screen:check": "node packages/screen-contracts/scripts/check.ts --require-implemented --require-e2e",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs --host 0.0.0.0 --port 5175",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0 --port 5175",
    "docs:generate": "pnpm codegen && pnpm screen:generate",
    "docs:check": "pnpm codegen:check && pnpm screen:check && pnpm docs:build"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1150.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "aws-amplify": "6.22.1",
    "aws-jwt-verify": "5.2.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.9.1"
  }
}
