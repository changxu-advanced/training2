{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.git",
      "!**/.env",
      "!**/.env.*",
      "!**/pnpm-lock.yaml",
      "!**/devcontainer-lock.json",
      "!**/.devcontainer/runtime",
      "!**/packages/prisma/generated",
      "!**/api-client/src/public.ts",
      "!**/api-client/src/private.ts",
      "!**/api-client/src/*.types.ts",
      "!**/schemas/openapi"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
